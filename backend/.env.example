APP_NAME=ProductProof AI
API_PREFIX=/api/v1

# MongoDB Atlas (primary operational DB + vector RAG + audit logs)
# Leave empty to run without persistence; /verify still returns a report but
# review history and manual overrides are disabled.
MONGODB_URI=
MONGODB_DB=productproof
MONGODB_RAG_COLLECTION=knowledge_chunks
MONGODB_IMAGE_COLLECTION=image_signatures
MONGODB_AUDIT_COLLECTION=verification_records
MONGODB_VECTOR_INDEX=knowledge_vector_index

# Gemini: image understanding + embeddings
GOOGLE_API_KEY=
GEMINI_VLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TIMEOUT_SECONDS=45

# Groq: fast final reasoning/report generation
GROQ_API_KEY=
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# Local vision models
VISION_EMBEDDING_MODEL=openai/clip-vit-base-patch32
ULTRALYTICS_MODEL=yolo11n.pt

# Speed / quality
OCR_LANGUAGES=en
OCR_USE_GPU=false
OCR_MAX_DIM=1000
MAX_IMAGES=8
MAX_IMAGE_MB=10

# Scoring
APPROVE_THRESHOLD=80
REVIEW_THRESHOLD=55
MIN_AUTO_CONFIDENCE=0.78
USE_XGBOOST_FUSION=true
FUSION_MODEL_PATH=./data/models/fusion_model.json
MIN_TRAINING_SAMPLES=100

# Storage
UPLOAD_DIR=./data/uploads

# Browser origins allowed to call the API (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000
EXPRESS_ORIGIN=http://localhost:4000
SELLER_ORIGIN=http://localhost:5173
