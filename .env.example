# Copy to `.env` next to docker-compose.yml (it is gitignored) and edit.
# docker-compose.yml reads these at build and run time; they are NOT secrets.
# API keys and the Mongo URI belong in backend/.env instead.

# Browser origins allowed to call the gateway. With NODE_ENV=production the
# gateway ignores everything not listed here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Gateway origin baked into each frontend when its image is built. Changing
# these requires rebuilding that service:
#   docker compose build frontend seller
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Only used with `docker compose --profile https up -d`.
ADMIN_DOMAIN=admin.localhost
SELLER_DOMAIN=seller.localhost
API_DOMAIN=api.localhost
